# Get a free Census API key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# Get a free FRED API key at https://fred.stlouisfed.org/docs/api/api_key.html
# (optional — FRED data is not currently used in default pipeline)
FRED_API_KEY=your_fred_api_key_here

# GCP project that hosts the BigQuery datasets
GCP_PROJECT=your_gcp_project_id_here

# Path to the BigQuery service-account JSON keyfile.
# Used by both dbt (profiles.yml) and the ingestion scripts.
GCP_KEYFILE_PATH=path/to/service-account.json

# BigQuery dataset/table location. Must match across every dataset dbt
# creates (staging/intermediate/marts/raw) or cross-dataset joins will fail.
GCP_LOCATION=US
